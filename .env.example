# ─── Database ────────────────────────────────────────────
DB_NAME=devtools
DB_USER=postgres
DB_PASSWORD=postgres
# Local terminal: localhost
# Docker on Mac (Homebrew postgres): host.docker.internal
# Docker on Pi (postgres container): postgres
DB_HOST=localhost
DB_PORT=5432

# ─── Backend ─────────────────────────────────────────────
PORT=5039
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false

# ─── Frontend ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5039
FRONTEND_PORT=3000

# ─── Email (password reset) ──────────────────────────────
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
